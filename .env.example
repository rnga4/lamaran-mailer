# Salin file ini jadi ".env" lalu isi sesuai akun email pengirim kamu.
# Untuk Gmail: SMTP_PASSWORD wajib App Password (bukan password akun biasa),
# generate di https://myaccount.google.com/apppasswords (butuh 2FA aktif dulu).

# ── Akun Utama (wajib minimal satu) ──
SMTP_HOST=smtp.gmail.com
SMTP_PORT=465
SMTP_USER=YOUR_EMAIL@gmail.com
SMTP_PASSWORD=YOUR_APP_PASSWORD_HERE
SMTP_FROM=YOUR_EMAIL@gmail.com
SMTP_FROM_NAME=Your Full Name

# ── Akun Tambahan (opsional) ──
# Salin & rename SMTP -> SMTP2_, SMTP3_, dst untuk multi-akun.
# Berguna kalau satu akun kena rate limit Gmail (500/hari),
# aplikasi otomatis pindah ke akun berikutnya.
# SMTP2_HOST=smtp.gmail.com
# SMTP2_PORT=465
# SMTP2_USER=email2@gmail.com
# SMTP2_PASSWORD=YOUR_APP_PASSWORD_HERE
# SMTP2_FROM=email2@gmail.com
# SMTP2_FROM_NAME=Your Full Name

# SMTP3_HOST=smtp.gmail.com
# SMTP3_PORT=465
# SMTP3_USER=email3@gmail.com
# SMTP3_PASSWORD=YOUR_APP_PASSWORD_HERE
# SMTP3_FROM=email3@gmail.com
# SMTP3_FROM_NAME=Your Full Name

# ── Tanda Tangan Email (opsional, dipakai template default) ──
# Nama pakai SMTP_FROM_NAME. Kosongkan untuk placeholder.
SENDER_PHONE=08XX-XXXX-XXXX
SENDER_LINKEDIN=linkedin.com/in/username
SENDER_GITHUB=github.com/username

# Path CV di dalam container (default ambil file pertama dari folder ./cv)
CV_PATH=/app/cv/your_cv.pdf

# Rate limit per akun per jam (999999 = praktis tanpa limit)
RATE_LIMIT_PER_HOUR=999999

# Delay antar email batch (detik, random antara min-max)
# Biar pattern kirim gak keliatan bot
SEND_DELAY_MIN=30
SEND_DELAY_MAX=90

# Batas aman harian per akun (default 100, sesuaikan sendiri).
# Free Gmail 500, Workspace 2000 — tapi makin sedikit makin aman.
# CATATAN: limit ini sekarang DITEGAKKAN per akun SMTP — pengiriman otomatis
# berhenti begitu satu akun mencapai batas hariannya (aman dari suspend),
# lalu pindah ke akun berikutnya.
GMAIL_DAILY_LIMIT=100

# ── Keamanan Web UI (opsional tapi disarankan) ──
# Aktifkan login password supaya orang lain di jaringan tidak bisa
# memakai akun SMTP kamu atau mengunduh file CV.
# Kosongkan untuk menonaktifkan autentikasi (perilaku lama).
APP_PASSWORD=
# (opsional) Rahasia untuk tanda tangan cookie session.
# Kosongkan = dibuat acak setiap kali server start.
APP_SECRET=

# Mode keamanan koneksi SMTP per akun: 'ssl' (465) / 'starttls' (587).
# Kosongkan = otomatis (SSL jika port 465, STARTTLS untuk port lainnya).
# SMTP_SECURITY=ssl
# SMTP2_SECURITY=starttls

# Sebar email batch sepanjang hari (dalam jam) biar gak kentara bot.
# Misal 6 jam berarti 100 email disebar merata ~3.6 menit per email.
# Set 0 untuk pakai SEND_DELAY_MIN/MAX aja.
SPREAD_HOURS=6
